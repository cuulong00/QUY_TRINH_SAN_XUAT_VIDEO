# ==========================================
# FACEBOOK GRAPH API CONFIGURATION
# ==========================================
# ID của Fanpage (Dãy số, lấy từ Giới thiệu Trang hoặc URL)
FB_PAGE_ID=your_page_id_here

# Page Access Token vĩnh viễn (Never-expiring Page Access Token)
# Được sinh ra từ Meta for Developers > Graph API Explorer
# Quyền yêu cầu: pages_manage_posts, pages_read_engagement, publish_video
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Phiên bản Meta Graph API (mặc định v20.0)
FB_API_VERSION=v20.0

# Chunk size cho Resumable Video Upload (bytes). Mặc định 8MB (8 * 1024 * 1024)
FB_UPLOAD_CHUNK_SIZE_MB=8
